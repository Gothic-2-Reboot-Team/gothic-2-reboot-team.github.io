  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.114",
    "@types/node": "26.0.1",
    "sass-embedded": "1.100.0",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.5",
    "@nuxt/eslint": "1.15.2",
    "eslint": "10.4.1",
    "prettier": "3.8.5"
